# Base de datos Auth Service
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_AUTH_DATABASE=vetcore_auth_db
MYSQL_AUTH_USER=vetcore_auth_user
MYSQL_AUTH_PASSWORD=vetcore_pass

# Base de datos Patients Service
MYSQL_PATIENTS_DATABASE=vetcore_patients_db
MYSQL_PATIENTS_USER=vetcore_patients_user
MYSQL_PATIENTS_PASSWORD=vetcore_pass

# Auth Service
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=24h

# API Gateway
CORS_ORIGIN=*
NODE_ENV=production
